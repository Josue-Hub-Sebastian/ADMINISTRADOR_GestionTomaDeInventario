@using Gestion_TomaInventario.Models.ViewModels
@using Gestion_TomaInventario.Models.ViewModels.Backup
@model BackupConfigViewModel
@{
    ViewData["Title"] = "Configuración de Backup";
}

<div class="container py-4">

    <!-- Header Ejecutivo -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" class="text-decoration-none text-muted">Empresas</a>
                    </li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Configuración de Backup</li>
                </ol>
            </nav>
            <h2 class="m-0 fw-semibold" style="color: #1a1a2e;">
                <i class="bi bi-shield-check text-primary me-2"></i>Configuración de Backup
            </h2>
            <p class="text-muted m-0 mt-1 small">Gestión de respaldos automáticos y manuales del sistema</p>
        </div>
        @if (Model.Activo)
        {
            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2">
                <i class="bi bi-check-circle-fill me-1"></i> Servicio Activo
            </span>
        }
        else
        {
            <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                <i class="bi bi-x-circle-fill me-1"></i> Servicio Inactivo
            </span>
        }
    </div>

    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center border-0 border-start border-4 border-success" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center border-0 border-start border-4 border-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">

        <!-- Columna Principal: Configuración -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-semibold" style="color: #1a1a2e;">
                        <i class="bi bi-gear-wide-connected me-2 text-primary"></i>Parámetros del Respaldo
                    </h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Automático</span>
                </div>
                <div class="card-body px-4 pb-4">

                    <form asp-action="GuardarConfiguracion" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdEmpresa" />

                        <!-- Fila 1: Ruta, Frecuencia, Hora -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="RutaDestino" class="form-label fw-semibold small text-secondary">
                                    <i class="bi bi-folder2-open me-1 text-primary"></i> Ruta de destino
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-hdd"></i>
                                    </span>
                                    <input asp-for="RutaDestino" class="form-control border-start-0 bg-light" placeholder="D:\Backups\Cliente" />
                                </div>
                                <span asp-validation-for="RutaDestino" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Frecuencia" class="form-label fw-semibold small text-secondary">
                                    <i class="bi bi-calendar3 me-1 text-primary"></i> Frecuencia
                                </label>
                                <select asp-for="Frecuencia" class="form-select bg-light">
                                    <option value="DIARIA">Diaria</option>
                                    <option value="SEMANAL">Semanal</option>
                                    <option value="MENSUAL">Mensual</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Hora" class="form-label fw-semibold small text-secondary">
                                    <i class="bi bi-clock me-1 text-primary"></i> Hora de ejecución
                                </label>
                                <input asp-for="Hora" type="time" class="form-control bg-light" />
                            </div>
                        </div>

                        <!-- Fila 2: Máximo, Compresión, Activo -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <label asp-for="MaxRespaldos" class="form-label fw-semibold small text-secondary">
                                    <i class="bi bi-stack me-1 text-primary"></i> Máx. backups
                                </label>
                                <input asp-for="MaxRespaldos" type="number" min="1" class="form-control bg-light" />
                                <div class="form-text text-muted" style="font-size: 0.75rem;">Rotación automática</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small text-secondary">
                                    <i class="bi bi-shield-lock me-1 text-primary"></i> Opciones de seguridad
                                </label>
                                <div class="d-flex flex-column gap-2 mt-2">
                                    <div class="form-check form-switch">
                                        <input asp-for="Comprimir" class="form-check-input" type="checkbox" style="width: 2.5em; height: 1.2em;" />
                                        <label asp-for="Comprimir" class="form-check-label small">
                                            Comprimir <span class="badge bg-dark ms-1" style="font-size: 0.65rem;">7-Zip AES-256</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold small text-secondary">
                                    <i class="bi bi-power me-1 text-primary"></i> Estado del servicio
                                </label>
                                <div class="d-flex flex-column gap-2 mt-2">
                                    <div class="form-check form-switch">
                                        <input asp-for="Activo" class="form-check-input" type="checkbox" style="width: 2.5em; height: 1.2em;" />
                                        <label asp-for="Activo" class="form-check-label small fw-semibold @(Model.Activo ? "text-success" : "text-muted")">
                                            Backup activo
                                            @if (Model.Activo)
                                            {
                                                <span class="badge bg-success ms-1" style="font-size: 0.65rem;">EN LÍNEA</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary ms-1" style="font-size: 0.65rem;">DETENIDO</span>
                                            }
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Botón Guardar -->
                        <div class="d-flex justify-content-end pt-3" style="border-top: 1px solid #e5e7eb;">
                            <button type="submit" class="btn btn-primary px-4 fw-medium" style="border-radius: 8px;">
                                <i class="bi bi-save me-2"></i>Guardar configuración
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

        <!-- Columna Lateral: Acciones y Estado -->
        <div class="col-lg-4">

            <!-- Tarjeta de Estado -->
            <div class="card border-0 shadow-sm mb-4 text-white" style="border-radius: 12px; background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <p class="m-0 small" style="opacity: 0.85;">Servicio configurado</p>
                            <h4 class="m-0 fw-semibold">Backup Automático</h4>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-3 p-2">
                            <i class="bi bi-hdd-stack fs-4"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center small" style="opacity: 0.9;">
                        <span><i class="bi bi-shield-check me-1"></i> Encriptación AES-256</span>
                        <span class="badge bg-white text-primary" style="font-size: 0.7rem;">Protegido</span>
                    </div>
                </div>
            </div>

            <!-- Acciones Rápidas -->
            <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h6 class="m-0 fw-semibold" style="color: #1a1a2e;">
                        <i class="bi bi-lightning-charge me-2 text-warning"></i>Acciones Rápidas
                    </h6>
                </div>
                <div class="card-body px-4 pb-4">

                    <form asp-action="EjecutarManual" method="post"
                          onsubmit="return confirm('¿Ejecutar el backup ahora? Esto puede tardar unos minutos.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idEmpresa" value="@Model.IdEmpresa" />
                        <button type="submit" class="btn w-100 mb-3 d-flex align-items-center justify-content-center gap-2 fw-medium"
                                style="background: #f3f4f6; color: #374151; border: 1px dashed #d1d5db; border-radius: 10px; padding: 0.8rem;">
                            <i class="bi bi-play-circle-fill fs-5 text-primary"></i>
                            Ejecutar backup manual
                        </button>
                    </form>

                    <a asp-action="Historial" asp-route-idEmpresa="@Model.IdEmpresa"
                       class="btn w-100 d-flex align-items-center justify-content-center gap-2 fw-medium text-decoration-none"
                       style="background: #fff; color: #0d6efd; border: 1px solid #e5e7eb; border-radius: 10px; padding: 0.8rem;">
                        <i class="bi bi-clock-history fs-5"></i>
                        Ver historial completo
                    </a>
                </div>
            </div>

            <!-- Volver -->
            <div class="mt-4 text-center">
                <a asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Volver a la lista de empresas
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}