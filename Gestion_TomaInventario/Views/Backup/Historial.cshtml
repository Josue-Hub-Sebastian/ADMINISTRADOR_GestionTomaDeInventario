@using Gestion_TomaInventario.Models.ViewModels
@using Gestion_TomaInventario.Models.ViewModels.Backup
@model IReadOnlyList<BackupHistorialViewModel>
@{
    ViewData["Title"] = "Historial de Backups";

    // Métricas
    var total = Model.Count;
    var exitosos = Model.Count(x => x.Estado == "EXITOSO");
    var errores = Model.Count(x => x.Estado == "ERROR");
    var enProceso = Model.Count(x => x.Estado == "EN_PROCESO");
    var eliminados = Model.Count(x => x.Estado == "ELIMINADO");
}

<div class="container py-4">

    <!-- Header Ejecutivo -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">Empresas</a></li>
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">Configuración</a></li>
                    <li class="breadcrumb-item active text-primary fw-medium">Historial de Backups</li>
                </ol>
            </nav>
            <h2 class="m-0 fw-semibold" style="color: #1a1a2e;">
                <i class="bi bi-clock-history text-primary me-2"></i>Historial de Backups
            </h2>
            <p class="text-muted m-0 mt-1 small">Registro de todas las ejecuciones de respaldo</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-medium" style="border-radius: 8px;">
            <i class="bi bi-arrow-left me-1"></i> Volver a configuración
        </a>
    </div>

    <!-- Métricas -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #e7f1ff;">
                        <i class="bi bi-hdd-stack text-primary fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted m-0 small">Total backups</p>
                        <h4 class="m-0 fw-bold" style="color: #1a1a2e;">@total</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #d1fae5;">
                        <i class="bi bi-check-circle-fill text-success fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted m-0 small">Exitosos</p>
                        <h4 class="m-0 fw-bold text-success">@exitosos</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #fee2e2;">
                        <i class="bi bi-x-circle-fill text-danger fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted m-0 small">Con errores</p>
                        <h4 class="m-0 fw-bold text-danger">@errores</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #fef3c7;">
                        <i class="bi bi-hourglass-split text-warning fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted m-0 small">En proceso</p>
                        <h4 class="m-0 fw-bold" style="color: #b45309;">@enProceso</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center border-0 border-start border-4 border-success mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center border-0 border-start border-4 border-danger mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <!-- Toolbar -->
        <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <h5 class="m-0 fw-semibold" style="color: #1a1a2e;">
                <i class="bi bi-list-ul me-2 text-primary"></i>Registros
            </h5>
            <div class="d-flex gap-2">
                <div class="input-group" style="max-width: 260px;">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-start-0 bg-light" placeholder="Buscar archivo..." id="buscarTabla">
                </div>
                <select class="form-select bg-light" style="max-width: 160px;" id="filtroEstado">
                    <option value="">Todos los estados</option>
                    <option value="EXITOSO">Exitoso</option>
                    <option value="ERROR">Error</option>
                    <option value="EN_PROCESO">En proceso</option>
                    <option value="ELIMINADO">Eliminado</option>
                </select>
            </div>
        </div>

        <div class="card-body px-4 pb-4 pt-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tablaHistorial">
                    <thead>
                        <tr style="border-bottom: 2px solid #e5e7eb;">
                            <th class="fw-semibold small text-secondary" style="width: 32%;">Archivo</th>
                            <th class="fw-semibold small text-secondary">Inicio</th>
                            <th class="fw-semibold small text-secondary">Fin</th>
                            <th class="fw-semibold small text-secondary">Peso</th>
                            <th class="fw-semibold small text-secondary">Duración</th>
                            <th class="fw-semibold small text-secondary">Estado</th>
                            <th class="fw-semibold small text-secondary text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(h => h.FechaInicio))
                        {
                            // Clase de fila
                            var filaClass = item.Estado == "ELIMINADO" ? "text-muted" : "";
                            var filaBg = item.Estado == "ELIMINADO" ? "style=\"background: #f9fafb;\"" : "";

                            // Badge
                            string badgeClass = item.Estado switch
                            {
                                "EXITOSO" => "bg-success-subtle text-success",
                                "ERROR" => "bg-danger-subtle text-danger",
                                "EN_PROCESO" => "bg-warning-subtle text-warning",
                                "ELIMINADO" => "bg-secondary-subtle text-secondary",
                                _ => "bg-light text-dark"
                            };

                            string badgeIcon = item.Estado switch
                            {
                                "EXITOSO" => "bi-check-circle-fill",
                                "ERROR" => "bi-x-circle-fill",
                                "EN_PROCESO" => "bi-hourglass-split",
                                "ELIMINADO" => "bi-trash",
                                _ => "bi-question-circle"
                            };

                            // Icono archivo
                            string iconoArchivo = item.Estado == "ERROR" ? "bi-file-earmark-x" :
                            item.Estado == "ELIMINADO" ? "bi-file-earmark" : "bi-file-earmark-zip";
                            string colorIcono = item.Estado == "EXITOSO" ? "text-success" :
                            item.Estado == "ERROR" ? "text-danger" :
                            item.Estado == "EN_PROCESO" ? "text-warning" : "text-secondary";
                            string bgIcono = item.Estado == "EXITOSO" ? "#d1fae5" :
                            item.Estado == "ERROR" ? "#fee2e2" :
                            item.Estado == "EN_PROCESO" ? "#fef3c7" : "#e5e7eb";

                            // Duración
                            string duracion = "-";
                            if (item.FechaFin.HasValue && item.FechaInicio != default)
                            {
                                var diff = item.FechaFin.Value - item.FechaInicio;
                                duracion = diff.TotalMinutes < 1
                                ? $"{diff.Seconds}s"
                                : $"{(int)diff.TotalMinutes} min {diff.Seconds}s";
                            }

                            <tr class="@filaClass" style="border-bottom: 1px solid #f3f4f6; @(item.Estado == "ELIMINADO" ? "background: #f9fafb;" : "")" data-estado="@item.Estado">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: @bgIcono;">
                                            <i class="bi @iconoArchivo @colorIcono"></i>
                                        </div>
                                        <div>
                                            <span class="fw-medium small d-block @(item.Estado == "ELIMINADO" ? "text-muted" : "")" style="color: #1a1a2e;">@item.ArchivoGenerado</span>
                                            <span class="text-muted" style="font-size: 0.7rem;">
                                                @(item.Estado == "ELIMINADO" ? "Eliminado por rotación" : "Compresión AES-256")
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="small text-secondary">@item.FechaInicio.ToString("dd/MM/yyyy HH:mm")</span></td>
                                <td><span class="small @(item.FechaFin.HasValue ? "text-secondary" : "text-muted")">@(item.FechaFin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span></td>
                                <td><span class="fw-medium small @(item.PesoMB.HasValue ? "" : "text-muted")" style="color: #1a1a2e;">@(item.PesoMB?.ToString("N2") + " MB" ?? "—")</span></td>
                                <td><span class="small text-secondary">@duracion</span></td>
                                <td>
                                    @if (item.Estado == "EN_PROCESO")
                                    {
                                        <span class="badge rounded-pill @badgeClass border" style="font-size: 0.75rem;">
                                            <span class="spinner-border spinner-border-sm me-1" style="width: 0.6rem; height: 0.6rem;"></span>@item.Estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill @badgeClass border" style="font-size: 0.75rem;">
                                            <i class="bi @badgeIcon me-1"></i>@item.Estado
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!string.IsNullOrEmpty(item.MensajeError))
                                    {
                                        <button type="button" class="btn btn-sm btn-light text-danger"
                                                data-bs-toggle="tooltip" data-bs-placement="left"
                                                data-bs-html="true"
                                                title="<strong>Error:</strong><br/>@System.Net.WebUtility.HtmlEncode(item.MensajeError)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-light text-muted" disabled>
                                            <i class="bi bi-download"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2 mb-0">No hay registros de backup para mostrar.</p>
                </div>
            }

            <!-- Paginación visual (placeholder, integrar con tu lógica de paginación real) -->
            @if (Model.Count > 10)
            {
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top: 1px solid #e5e7eb;">
                    <span class="text-muted small">Mostrando <strong>1-@Model.Count</strong> de <strong>@Model.Count</strong> registros</span>
                    <nav>
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
                            <li class="page-item active"><a class="page-link bg-primary border-primary" href="#">1</a></li>
                            <li class="page-item"><a class="page-link text-primary" href="#">2</a></li>
                            <li class="page-item"><a class="page-link text-primary" href="#"><i class="bi bi-chevron-right"></i></a></li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Filtro por estado
        document.getElementById('filtroEstado').addEventListener('change', function () {
            var filtro = this.value.toUpperCase();
            var filas = document.querySelectorAll('#tablaHistorial tbody tr');
            filas.forEach(function (fila) {
                var estado = fila.getAttribute('data-estado');
                if (!filtro || estado === filtro) {
                    fila.style.display = '';
                } else {
                    fila.style.display = 'none';
                }
            });
        });

        // Búsqueda por texto
        document.getElementById('buscarTabla').addEventListener('keyup', function () {
            var texto = this.value.toLowerCase();
            var filas = document.querySelectorAll('#tablaHistorial tbody tr');
            filas.forEach(function (fila) {
                var contenido = fila.innerText.toLowerCase();
                fila.style.display = contenido.includes(texto) ? '' : 'none';
            });
        });
    </script>
}