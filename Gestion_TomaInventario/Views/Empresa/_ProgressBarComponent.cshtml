@model dynamic

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="fw-bold text-dark">@Model.Titulo</span>
        <span class="text-muted small">
            <strong class="text-dark">@Model.Actual</strong> / @Model.Max
            (@string.Format("{0:0.0}", Model.Porcentaje)%)
        </span>
    </div>
    <div class="progress" style="height: 12px; background-color: #e9ecef; border-radius: 6px;">
        <div class="progress-bar @Model.Color"
             role="progressbar"
             style="width: @(Model.Porcentaje > 100 ? 100 : Model.Porcentaje)%; transition: width 0.6s ease;"
             aria-valuenow="@Model.Porcentaje"
             aria-valuemin="0"
             aria-valuemax="100">
        </div>
    </div>
</div>