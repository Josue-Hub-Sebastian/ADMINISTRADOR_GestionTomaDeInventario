@using Gestion_TomaInventario.Models
@using Gestion_TomaInventario.Models.ViewModels
@model IReadOnlyList<LicenciaViewModel>

@{
    ViewData["Title"] = "Licencias";
}
@section Styles {
    <link rel="stylesheet" href="~/css/licencias.css" asp-append-version="true" />
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<div class="container-fluid py-4">

    <!-- HEADER PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded shadow-sm">
        <div class="d-flex align-items-center">
            <div class="me-3">
                <img src="~/images/central-panel-anim.gif" alt="Animación Panel" style="width: 55px; height: 55px; object-fit: contain;"
                     onerror="this.onerror=null; this.src='https://cdn-icons-png.flaticon.com/512/2311/2311545.png';">
            </div>
            <div>
                <h2 class="mb-0 fw-bold text-dark" style="letter-spacing: -0.5px;">Panel de Licencias</h2>
                <small class="text-muted">
                    <i class="bi bi-shield-check text-primary"></i> Caracteristicas Maximas 
                </small>
            </div>
        </div>

        <div class="gap-2 d-md-flex">
            @* <button class="btn btn-success px-3 shadow-sm fw-semibold">
                <i class="bi bi-plus-lg"></i> Nueva Empresa
            </button> *@
            <button class="btn btn-outline-primary px-3 shadow-sm fw-semibold" onclick="location.reload();">
                <i class="bi bi-arrow-clockwise"></i> Sincronizar
            </button>
        </div>
    </div>

    <!-- TARJETAS DE MÉTRICAS -->
    <div class="row mb-4 g-3">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="p-3 bg-primary bg-opacity-10 rounded text-primary me-3">
                        <i class="bi bi-building fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase fw-bold">Empresas</h6>
                        <h3 class="fw-bold mb-0 text-dark" id="totalEmpresas">@(Model?.Count ?? 0)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="p-3 bg-success bg-opacity-10 rounded text-success me-3">
                        <i class="bi bi-database-check fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase fw-bold">Instancias Activas</h6>
                        <h3 class="fw-bold mb-0 text-success">@(Model?.Count ?? 0)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="p-3 bg-warning bg-opacity-10 rounded text-warning me-3">
                        <i class="bi bi-hdd-network fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase fw-bold">Servidor VPS</h6>
                        <h3 class="fw-bold mb-0 text-warning">US-NY2</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="p-3 bg-info bg-opacity-10 rounded text-info me-3">
                        <i class="bi bi-cpu fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase fw-bold">Motor DB</h6>
                        <h3 class="fw-bold mb-0 text-info">SQL Express</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BARRA DE BÚSQUEDA Y TABLA -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-0">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="fw-bold text-secondary">
                        <i class="bi bi-list-stars text-primary"></i>
                        Licencias Clientes
                        (<span id="contadorLicencias">@(Model?.Count ?? 0)</span>)
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex justify-content-end align-items-center gap-2">
                        <span class="badge bg-light text-dark border">Producción</span>
                        <span class="result-count" id="resultadoBusqueda" style="display: none;">
                            <i class="bi bi-search"></i> <span id="textoResultado"></span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- 🔍 BARRA DE BÚSQUEDA -->
            <div class="row mt-3">
                <div class="col-12">
                    <div class="search-box">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text"
                               id="searchInput"
                               class="form-control"
                               placeholder="Buscar por nombre de empresa, RUC o base de datos..."
                               autocomplete="off">
                        <i class="bi bi-x-circle-fill clear-search" id="clearSearch" onclick="limpiarBusqueda()"></i>
                    </div>
                    @* <div class="mt-2">
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i>
                            Búsqueda inteligente: coincidencias parciales, ignora mayúsculas y espacios
                        </small>
                    </div> *@
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <img src="https://cdn.dribbble.com/users/722246/screenshots/4400319/loading_animation.gif"
                         alt="No data" style="max-width: 250px; mix-blend-mode: multiply;">
                    <h5 class="mt-3 text-secondary fw-semibold">No se encontraron licencias registradas</h5>
                    <p class="text-muted small">Verifica la inicialización del archivo json o ejecuta los scripts de sincronización.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table id="tblLicencias" class="table table-hover align-middle mb-0 custom-table">
                        <thead class="table-light text-secondary small text-uppercase">
                            <tr>
                                <th class="ps-4">Empresa</th>
                                <th>RUC / Identidad</th>
                                <th>Base de Datos</th>
                                <th class="text-center">Almacenes</th>
                                <th class="text-center">Ubicaciones</th>
                                <th class="text-center">Productos</th>
                                <th class="text-center">Admins</th>
                                <th class="text-center">Operadores</th>
                                <th class="text-center">Inventarios Plan</th>
                                <th class="text-end pe-4" width="180">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var licencia in Model)
                            {
                                <tr data-search="@licencia.Nombre.ToLower() @licencia.Ruc.ToLower() @licencia.NombreBD.ToLower()">
                                    <td class="ps-4 fw-bold text-dark">
                                        <i class="bi bi-building me-1 text-secondary"></i>
                                        <span class="nombre-empresa">@licencia.Nombre</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border ruc-empresa">@licencia.Ruc</span>
                                    </td>
                                    <td class="text-muted">
                                        <i class="bi bi-database text-info small"></i>
                                        <span class="bd-empresa">@licencia.NombreBD</span>
                                    </td>
                                    <td class="text-center fw-semibold text-secondary">@licencia.AlmacenesMax</td>
                                    <td class="text-center text-secondary">@licencia.UbicacionesMax</td>
                                    <td class="text-center text-secondary">@licencia.ProductosMax</td>
                                    <td class="text-center text-secondary">@licencia.UsuariosAdminMax</td>
                                    <td class="text-center text-secondary">@licencia.UsuariosOperadorMax</td>
                                    <td class="text-center">
                                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold">
                                            @licencia.InventariosPreparadosMax
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm" role="group">
                                            <a class="btn btn-sm btn-light border text-info"
                                               asp-controller="Empresa" asp-action="Dashboard" asp-route-idEmpresa="@licencia.IdEmpresa"
                                               title="Ver Dashboard del Cliente">
                                                <i class="bi bi-speedometer2"></i>
                                            </a>
                                            <a class="btn btn-sm btn-light border text-warning"
                                               asp-controller="Empresa" asp-action="Editar" asp-route-id="@licencia.IdEmpresa"
                                               title="Modificar Límites">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- MENSAJE DE "SIN RESULTADOS" -->
                <div id="noResults" class="no-results" style="display: none;">
                    <i class="bi bi-search"></i>
                    <h5 class="text-secondary fw-semibold mt-3">Sin coincidencias</h5>
                    <p class="text-muted small">
                        No se encontraron licencias que coincidan con <strong id="terminoBusqueda"></strong>
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/licencias.js" asp-append-version="true"></script>
}