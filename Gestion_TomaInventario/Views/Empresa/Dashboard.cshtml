@using Gestion_TomaInventario.Models.ViewModels
@model DashboardEmpresaViewModel

@{
    ViewData["Title"] = "Dashboard de Control - " + (Model?.NombreEmpresa ?? "Empresa no encontrada");
}
<!-- resto del archivo intacto -->

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Panel Central</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(Model?.NombreEmpresa ?? "—")</li>
            </ol>
        </nav>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Volver a Clientes
        </a>
    </div>

    @if (Model == null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> No se pudo cargar la información detallada de la empresa seleccionada.
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-start border-4 @(Model.EstadoLicencia ? "border-success" : "border-danger")">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <h4 class="card-title text-primary mb-1">@Model.NombreEmpresa</h4>
                                <p class="text-muted small mb-0"><strong>RUC:</strong> @Model.Ruc</p>
                            </div>
                            <div class="col-md-4 border-start border-end">
                                <p class="mb-1"><strong>Base de Datos:</strong> <code class="text-dark">@Model.NombreBD</code></p>
                                <p class="text-muted small mb-0"><strong>Instalada el:</strong> @Model.FechaCreacionBD.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                            <div class="col-md-4 text-md-end mt-2 mt-md-0">
                                <span class="badge p-2 @(Model.EstadoLicencia ? "bg-success" : "bg-danger")">
                                    <i class="bi @(Model.EstadoLicencia ? "bi-check-circle" : "bi-dash-circle") me-1"></i>
                                    @(Model.EstadoLicencia ? "Licencia Activa" : "Licencia Inactiva / Suspendida")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light">
                        <h5 class="mb-0 text-secondary"><i class="bi bi-pie-chart-fill me-2"></i>Consumo Actual vs. Límites del Plan</h5>
                    </div>
                    <div class="card-body p-4">

                        @await Html.PartialAsync("_ProgressBarComponent", new {
                        Titulo = "Productos en Catálogo",
                                        Actual = Model.ProductosActual,
                                        Max = Model.ProductosMax,
                                        Porcentaje = Model.ProductosPorcentaje,
                                        Color = Model.ProductosPorcentaje >= 90 ? "bg-danger" : (Model.ProductosPorcentaje >= 75 ? "bg-warning" : "bg-success")
                                        })

                    @await Html.PartialAsync("_ProgressBarComponent", new {
                                        Titulo = "Almacenes Habilitados",
                                        Actual = Model.AlmacenesActual,
                                        Max = Model.AlmacenesMax,
                                        Porcentaje = Model.AlmacenesPorcentaje,
                                        Color = Model.AlmacenesPorcentaje >= 90 ? "bg-danger" : (Model.AlmacenesPorcentaje >= 75 ? "bg-warning" : "bg-success")
                                        })

                    @await Html.PartialAsync("_ProgressBarComponent", new {
                                        Titulo = "Ubicaciones Físicas",
                                        Actual = Model.UbicacionesActual,
                                        Max = Model.UbicacionesMax,
                                        Porcentaje = Model.UbicacionesPorcentaje,
                                        Color = Model.UbicacionesPorcentaje >= 90 ? "bg-danger" : (Model.UbicacionesPorcentaje >= 75 ? "bg-warning" : "bg-success")
                                        })

                    @await Html.PartialAsync("_ProgressBarComponent", new {
                                        Titulo = "Inventarios Preparados",
                                        Actual = Model.InventariosPreparadosActual,
                                        Max = Model.InventariosPreparadosMax,
                                        Porcentaje = Model.InventariosPreparadosPorcentaje,
                                        Color = Model.InventariosPreparadosPorcentaje >= 90 ? "bg-danger" : (Model.InventariosPreparadosPorcentaje >= 75 ? "bg-warning" : "bg-info")
                                        })

                    @await Html.PartialAsync("_ProgressBarComponent", new {
                                        Titulo = "Usuarios Administradores",
                                        Actual = Model.UsuariosAdminActual,
                                        Max = Model.UsuariosAdminMax,
                                        Porcentaje = Model.UsuariosAdminPorcentaje,
                                        Color = Model.UsuariosAdminPorcentaje >= 90 ? "bg-danger" : "bg-secondary"
                                        })

                    @await Html.PartialAsync("_ProgressBarComponent", new {
                                        Titulo = "Usuarios Operadores (App Móvil)",
                                        Actual = Model.UsuariosOperadorActual,
                                        Max = Model.UsuariosOperadorMax,
                                        Porcentaje = Model.UsuariosOperadorPorcentaje,
                                        Color = Model.UsuariosOperadorPorcentaje >= 90 ? "bg-danger" : "bg-secondary"
                                        })

                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">

            <div class="card shadow-sm border-warning h-100">

                <div class="card-header bg-warning bg-opacity-10">

                    <div class="d-flex justify-content-between align-items-center">

                        <h5 class="mb-0">
                            <i class="bi bi-person-lines-fill me-2"></i>
                            Datos de Contacto
                        </h5>

                        @if (Model.Contacto != null)
                        {
                            <button type="button"
                                    id="btnEditarContacto"
                                    class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                        }

                    </div>

                </div>

                <div class="card-body">

                    @if (Model.Contacto == null)
                    {
                        <div id="panelSinContacto" class="text-center py-5">

                            <i class="bi bi-person-x text-warning display-3"></i>

                            <h5 class="fw-bold mt-3">
                                No existe un contacto registrado
                            </h5>

                            <p class="text-muted">

                                Registra el contacto principal de esta empresa para soporte,
                                renovaciones y comunicaciones importantes.

                            </p>

                            <button class="btn btn-warning"
                                    id="btnNuevoContacto">

                                <i class="bi bi-plus-circle"></i>

                                Registrar Contacto

                            </button>

                        </div>

                        <div id="panelFormulario" class="d-none">

                            <form id="frmContacto" novalidate>

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="IdEmpresa"
                                       value="@Model.IdEmpresa" />

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">

                                        Empresa

                                    </label>

                                    <input class="form-control"
                                           readonly
                                           value="@Model.NombreEmpresa" />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">

                                        Contacto

                                    </label>

                                    <input name="NombreContacto"
                                           required
                                           maxlength="150"
                                           class="form-control contacto-input" />
                                    <div class="invalid-feedback">Ingresa el nombre del contacto.</div>

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">

                                        Teléfono

                                    </label>

                                    <input name="TelefonoContacto"
                                           type="tel"
                                           required
                                           pattern="[0-9+ ]{6,15}"
                                           class="form-control contacto-input" />
                                    <div class="invalid-feedback">Ingresa un teléfono válido (6 a 15 dígitos).</div>

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">

                                        Correo

                                    </label>

                                    <input name="CorreoContacto"
                                           type="email"
                                           required
                                           class="form-control contacto-input" />
                                    <div class="invalid-feedback">Ingresa un correo válido.</div>

                                </div>

                                <div id="accionesContacto">

                                    <div class="d-grid gap-2">

                                        <button type="submit" class="btn btn-success">

                                            <i class="bi bi-check-circle"></i>

                                            Guardar

                                        </button>

                                        <button type="button"
                                                id="btnCancelarContacto"
                                                class="btn btn-outline-secondary">

                                            Cancelar

                                        </button>

                                    </div>

                                </div>

                            </form>

                        </div>
                    }
                    else
                    {
                        <div id="panelFormulario">

                            <form id="frmContacto" novalidate>

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="IdEmpresa"
                                       value="@Model.IdEmpresa" />

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">

                                        Empresa

                                    </label>

                                    <input class="form-control"
                                           readonly
                                           value="@Model.NombreEmpresa" />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">

                                        Contacto

                                    </label>

                                    <input name="NombreContacto"
                                           required
                                           maxlength="150"
                                           class="form-control contacto-input"
                                           value="@Model.Contacto.NombreContacto" />
                                    <div class="invalid-feedback">Ingresa el nombre del contacto.</div>

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">

                                        Teléfono

                                    </label>

                                    <input name="TelefonoContacto"
                                           type="tel"
                                           required
                                           pattern="[0-9+ ]{6,15}"
                                           class="form-control contacto-input"
                                           value="@Model.Contacto.TelefonoContacto" />
                                    <div class="invalid-feedback">Ingresa un teléfono válido (6 a 15 dígitos).</div>

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">

                                        Correo

                                    </label>

                                    <input name="CorreoContacto"
                                           type="email"
                                           required
                                           class="form-control contacto-input"
                                           value="@Model.Contacto.CorreoContacto" />
                                    <div class="invalid-feedback">Ingresa un correo válido.</div>

                                </div>

                                <div id="accionesContacto" class="d-none">

                                    <div class="d-grid gap-2">

                                        <button type="submit" class="btn btn-success">

                                            <i class="bi bi-check-circle"></i>

                                            Guardar

                                        </button>

                                        <button type="button"
                                                id="btnCancelarContacto"
                                                class="btn btn-outline-secondary">

                                            Cancelar

                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
        }
</div>


@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/dash.js" asp-append-version="true"></script>
}
