@using Gestion_TomaInventario.Models.Log
@model Login

@{
    ViewData["Title"] = "Iniciar sesion";
}

<div class="login-shell">
    <section class="login-panel">
        <div class="login-brand">
            <div class="brand-mark">GT</div>
            <div>
                <span>Gestion interna</span>
                <strong>Toma Inventario</strong>
            </div>
        </div>

        <div class="login-header">
            <span class="hero-kicker">Acceso seguro</span>
            <h1>Bienvenido</h1>
            <p>Consulta y sincroniza datos de clientes desde el panel web.</p>
        </div>

        <form asp-action="Login" method="post" class="login-form" id="loginForm">
            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="form-floating mb-3">
                <input asp-for="Usuario" class="form-control" placeholder="Usuario" autocomplete="username" autofocus />
                <label asp-for="Usuario"></label>
                <span asp-validation-for="Usuario" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Contrasena" class="form-control" placeholder="Contrasena" autocomplete="current-password" />
                <label asp-for="Contrasena"></label>
                <span asp-validation-for="Contrasena" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-login w-100" id="loginButton">
                <span class="button-text">Ingresar</span>
                <span class="button-loader"></span>
            </button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
           //chapa lo que metas 
            const usuario = document.getElementById('Usuario');
            const contrasena = document.getElementById('Contrasena');
            const btn = document.getElementById('loginButton');

            //  para validar que coloque algo los campos para hacer la comprobacion 
            function updateButton() {
                const u = usuario?.value?.trim().length > 0;
                const p = contrasena?.value?.trim().length > 0;
                if (btn) btn.disabled = !(u && p);
            }

            document.addEventListener('DOMContentLoaded', function () {
                // estado inicial
                updateButton();
                // escuchar cambios
                usuario?.addEventListener('input', updateButton);
                contrasena?.addEventListener('input', updateButton);
            });
        })();
    </script>
}
